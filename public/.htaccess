# ─────────────────────────────────────────────────────────────────────────────
# Served from build/client when Plesk's Document Root points there.
#
# React Router fetches page data from URLs ending in ".data"
# (/student.data, /student/course/<id>.data). Those are API calls handled by
# Node — there is no such file on disk. Apache must hand them to Passenger
# instead of answering "file not found".
#
# Harmless anywhere else: Vite/Docker never read this file.
# ─────────────────────────────────────────────────────────────────────────────

# Never redirect /student to /student/ — a trailing slash makes Apache look for
# a directory index and 500 before the app is reached.
DirectorySlash Off

<IfModule mod_passenger.c>
    # Let the Node app answer anything that is not a real file in this folder.
    PassengerEnabled on
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Requests for files that do not exist stop rewriting here so Passenger
    # (not Apache's file handler) produces the response.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [L,PT]
</IfModule>
