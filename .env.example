# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
COOKIE_SECURE=true
APP_URL=https://yourdomain.com
# Set to true ONLY when the app runs behind a reverse proxy (Plesk/nginx/Docker)
# that appends the real client address to X-Forwarded-For. Enables IP-based
# rate limiting on the auth endpoints. With more than one proxy in front
# (e.g. Cloudflare -> nginx -> app) set TRUST_PROXY_HOPS to that count instead.
TRUST_PROXY=true
# TRUST_PROXY_HOPS=2

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-long-random-jwt-secret

# ── Initial admin (only read by `npx tsx scripts/seed-admin.ts`) ──────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-random-password
SEED_ADMIN_NAME=Admin User

# ── Admin notifications (Shopify order emails) ────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token

# ── Storyline (optional) ──────────────────────────────────────────────────────
# Extra origins a Storyline package may post its completion message from,
# comma-separated. Each lesson's embed URL origin is always accepted, so this
# is only needed when story.html is served from another host (e.g. a redirect
# to a CDN). See STORYLINE_INTEGRATION.md.
# STORYLINE_ALLOWED_ORIGINS=https://cdn.example.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
