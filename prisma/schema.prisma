generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
  CORPORATE
}

enum LicenseStatus {
  ACTIVE
  PENDING
  REVOKED
}

enum ContentType {
  STORYLINE
  VIDEO
}

enum CourseType {
  FREE
  PAID
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  VIDEO
  STORYLINE
  TEXT
  DOWNLOAD
}

enum FeedbackMode {
  RETRY
  REVEAL
  DEFAULT
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  name           String
  role           Role             @default(STUDENT)
  isBanned       Boolean          @default(false)
  isSuspended    Boolean          @default(false)
  banReason      String?
  maxDevices     Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  licenses       License[]
  progress       Progress[]
  lessonProgress LessonProgress[]
  enrollments    Enrollment[]
  passwordResets PasswordReset[]
  sessions       UserSession[]
  quizAttempts   QuizAttempt[]
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── User Session (Device Tracking) ──────────────────────────────────────────

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique // JWT token hash or session ID
  deviceId     String? // Browser fingerprint or user-agent hash
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId, isActive])
}

// ─── Course resources (handouts, worksheets, links) ───────────────────────────
// Shown in the course player's RESOURCES drawer and on /student/resources.
// Access is always checked against the learner's licence for `courseId`; the
// stored `url` is never sent to the browser for FILE resources - they are
// streamed through /student/resource/:id instead.
model CourseResource {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String? // optional: pin the resource to one lesson
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  description String?
  kind        String   @default("FILE") // "FILE" (uploaded) | "LINK" (YouTube/Vimeo/any URL)
  url         String
  fileName    String?
  fileType    String? // MIME type for FILE resources
  fileSize    Int? // bytes
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, order])
  @@index([lessonId])
}

// ─── Glossary ─────────────────────────────────────────────────────────────────
// Course-specific; a learner only ever sees the terms of courses they hold a
// licence for.
model GlossaryTerm {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term       String
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId, term])
}

// ─── Watch & Learn video (student dashboard) ──────────────────────────────────
// Admin-curated videos for the "Watch & Learn" strip. When no active rows
// exist the dashboard falls back to the channel's latest uploads (RSS).
model WatchVideo {
  id        String   @id @default(uuid())
  videoId   String // YouTube video id, e.g. "rdmWpQ0cm_0"
  title     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ─── Certificate template ─────────────────────────────────────────────
// The admin-editable completion certificate. Every column default is the value
// that was hardcoded in app/routes/certificate.$courseId.tsx before this table
// existed, and the table ships EMPTY, so certificates render byte-identically
// until an admin saves for the first time.
//
// Two kinds of row:
//   id = "global", courseId = null → the site-wide design (all the v1 admin
//                                    UI ever writes)
//   courseId = <course id>         → a per-course override. Schema and reader
//                                    already allow it; adding that UI later
//                                    needs no migration.
//
// The singleton is keyed by the literal id "global" — a primary key, so the
// database structurally cannot hold two. A UNIQUE index on the nullable
// courseId would NOT give that guarantee: Postgres permits unlimited NULLs in
// a unique index, so a second global row could slip in and the reader would
// pick one nondeterministically.
model CertificateTemplate {
  id       String  @id @default(uuid())
  courseId String? @unique
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Branding
  orgName        String  @default("Instructional Graphics Academy")
  logoUrl        String? // Cloudinary https URL from /upload; replaces the star badge
  accentColor    String  @default("#1D375F")
  secondaryColor String  @default("#C69445")
  borderStyle    String  @default("HATCH_RULE") // see BORDER_STYLES in certificate-template.ts
  fontPair       String  @default("CLASSIC") // key of FONT_PAIRS in certificate-template.ts

  // Wording. Plain text only — entity-escaped at render time. Never HTML.
  headline   String  @default("Certificate of Completion")
  introLine  String  @default("This certifies that")
  midLine    String  @default("has successfully completed")
  dateLabel  String  @default("Date of completion")
  footerNote String?

  // Signature block — hidden entirely when all three are empty
  signatureImageUrl String?
  signatureName     String?
  signatureTitle    String? @default("Course Director")

  // The medallion between the signature and the date
  showSeal      Boolean @default(true)
  sealText      String  @default("Course Complete")
  sealStarColor String  @default("#2C795A")

  // Course.summary printed under the course title, and the bottom-corner
  // verification line. verifyUrl is plain text, never a link.
  showCourseSummary Boolean @default(true)
  verifyUrl         String?

  // Layout / print. AUTO emits no @page rule at all, i.e. exactly how this
  // certificate printed before the feature existed.
  paperSize   String @default("LETTER") // AUTO | A4 | LETTER
  orientation String @default("LANDSCAPE") // PORTRAIT | LANDSCAPE
  dateFormat  String @default("MONTH_DAY_YEAR") // MONTH_DAY_YEAR | DAY_MONTH_YEAR | ISO

  // Optional extras
  showCertificateId   Boolean @default(true)
  showInstructor      Boolean @default(false)
  certificateIdPrefix String  @default("IG")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shopify webhook idempotency ───────────────────────────────────────────────
// One row per processed order. Inserted in the same transaction as the
// licences, so a retried/duplicate delivery hits the unique key and is dropped.
model ShopifyOrder {
  orderId     String   @id
  processedAt DateTime @default(now())
}

// ─── Course ───────────────────────────────────────────────────────────────────

model Course {
  id                String       @id @default(uuid())
  iconSet           String? // "market" | "money" - which module icon set the sidebar uses
  title             String
  summary           String? // Short one-liner description
  description       String? // Long rich-text description
  category          String?
  instructor        String?
  courseType        CourseType   @default(FREE)
  price             Float? // Only for PAID courses, in USD
  shopifyProductId  String? // Shopify Product ID for PAID courses
  status            CourseStatus @default(DRAFT)
  contentType       ContentType  @default(STORYLINE)
  embedUrl          String? // Articulate Storyline / iframe URL (flat courses)
  videoUrl          String? // YouTube, Vimeo, or direct .mp4 (flat courses)
  introVideoUrl     String? // Course intro/preview video
  thumbnailUrl      String? // Featured image URL
  isPublic          Boolean      @default(true) // false = unlisted (hidden from catalog, reachable by link/licence)
  difficulty        String? // "Beginner" | "Intermediate" | "Advanced"
  isQA              Boolean      @default(false)
  whatYouLearn      String?
  targetAudience    String?
  materialsIncluded String?
  requirements      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  licenses          License[]
  progress          Progress[]
  enrollments       Enrollment[]
  modules           Module[]
  resources         CourseResource[]
  glossary          GlossaryTerm[]
  certificateTemplate CertificateTemplate?
}

// ─── Module (Section) ─────────────────────────────────────────────────────────

model Module {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  summary   String? // Section summary / description
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  quizzes   Quiz[]

  @@index([courseId])
}

// ─── Lesson ───────────────────────────────────────────────────────────────────

model Lesson {
  id             String           @id @default(uuid())
  moduleId       String
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  lessonType     LessonType       @default(VIDEO)
  order          Int              @default(0)
  content        String? // Rich text / markdown for TEXT lessons
  videoUrl       String? // YouTube, Vimeo, or .mp4 for VIDEO lessons
  iframeEmbed    String? // Full <iframe> tag — overrides videoUrl when present
  embedUrl       String? // Articulate Storyline URL for STORYLINE lessons
  resourceUrl    String? // Download link for DOWNLOAD lessons
  thumbnailUrl   String? // Lesson thumbnail image URL
  duration       Int? // Duration in seconds
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lessonProgress LessonProgress[]
  resources      CourseResource[]

  @@index([moduleId])
}

// ─── Quiz ─────────────────────────────────────────────────────────────────────

model Quiz {
  id                   String       @id @default(uuid())
  moduleId             String
  module               Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  summary              String?
  order                Int          @default(0)
  timeLimit            Int          @default(0)
  hideQuizTime         Boolean      @default(false)
  feedbackMode         FeedbackMode @default(RETRY)
  attemptsAllowed      Int          @default(10)
  passingGrade         Int          @default(80)
  maxQuestionsAllowed  Int          @default(10)
  autoStart            Boolean      @default(false)
  questionLayout       String       @default("SINGLE")
  questionOrder        String       @default("RANDOM")
  hideQuestionNumber   Boolean      @default(false)
  shortAnswerCharLimit Int          @default(200)
  essayCharLimit       Int          @default(500)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  questions            Question[]
  attempts             QuizAttempt[]

  @@index([moduleId])
}

// ─── Question ─────────────────────────────────────────────────────────────────

model Question {
  id               String   @id @default(uuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionType     String   @default("MULTIPLE_CHOICE")
  title            String
  description      String?
  order            Int      @default(0)
  points           Int      @default(1)
  answerRequired   Boolean  @default(false)
  allowMultiple    Boolean  @default(false)
  randomizeAnswers Boolean  @default(false)
  createdAt        DateTime @default(now())
  answers          Answer[]
  attemptAnswers   QuizAttemptAnswer[]

  @@index([quizId])
}

// ─── Answer ───────────────────────────────────────────────────────────────────

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  videoUrl   String? // Optional video attached to this answer
  imageUrl   String? // Optional image for IMAGE_ANSWERING questions
  isOptional Boolean  @default(false) // Mark answer as optional
  matchText  String? // Right-column text for MATCHING questions
  order      Int      @default(0) // Display/expected order (ORDERING questions grade against this)

  @@index([questionId])
}

// ─── LessonProgress ───────────────────────────────────────────────────────────

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, lessonId])
}

// ─── Enrollment (for FREE courses) ────────────────────────────────────────────

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

// ─── License ──────────────────────────────────────────────────────────────────

model License {
  id             String        @id @default(uuid())
  key            String        @unique
  status         LicenseStatus @default(PENDING)
  customerEmail  String
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  shopifyOrderId String?
  isBulk         Boolean       @default(false)
  redeemedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, courseId, status])
  @@index([courseId])
  @@index([shopifyOrderId])
}

// ─── QuizAttempt ──────────────────────────────────────────────────────────────

model QuizAttempt {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int                 @default(0)
  maxScore    Int                 @default(0)
  isPassed    Boolean             @default(false)
  submittedAt DateTime            @default(now())
  answers     QuizAttemptAnswer[]

  @@index([userId, quizId])
  @@index([quizId])
}

// ─── Progress ─────────────────────────────────────────────────────────────────

model Progress {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completionPercent Int       @default(0)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  certificateUrl    String?
  lastAccessedAt    DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, courseId])
}

// ─── QuizAttemptAnswer ─────────────────────────────────────────────────────

model QuizAttemptAnswer {
  id           String      @id @default(uuid())
  attemptId    String
  attempt      QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String? // SetNull when the question is deleted — the attempt and its score survive
  question     Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answerId     String?
  answerText   String?
  isCorrect    Boolean?
  pointsEarned Int       @default(0)
  manualScore  Int?
  gradedAt     DateTime?
  gradedBy     String?

  @@index([attemptId])
  @@index([questionId])
}
